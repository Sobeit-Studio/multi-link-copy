{
  "name": "Multi-Link-Copy",
  "version": "1.0.0",
  "description": "A Figma plugin for batch copying multiple component or frame URLs",
  "main": "code.js",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && esbuild src/code.ts --bundle --target=es2017 --outfile=code.js",
    "watch": "esbuild src/code.ts --bundle --target=es2017 --outfile=code.js --watch",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "eslint --ext .ts src",
    "lint:fix": "eslint --ext .ts --fix src"
  },
  "author": "Sebastian Delgadillo",
  "license": "MIT",
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.54.0",
    "typescript": "^5.3.2"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@figma/figma-plugins/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "root": true,
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    }
  }
}
